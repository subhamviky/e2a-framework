digraph G {
  graph [rankdir=TB, fontname="DejaVu Sans", fontsize=13, labelloc=t, label=<<b>BaseInfraProvisioner.provision_landing_zone() — fixed seven-step order</b>>, fontcolor="#1F3864", nodesep=0.25, ranksep=0.35, pad=0.2];
  node [shape=box, style="rounded,filled", fillcolor="#F4F8FC", color="#1F3864", fontname="DejaVu Sans", fontsize=10.5, fontcolor="#1F3864", margin="0.12,0.06", width=1.6];
