  p1 [label="1 Network topologies\nDMZ · Private VPC · perimeter\nAZ/region count by tier"]; p2 [label="2 Edge security\nT0 gateway + WAF"]; p3 [label="3 Data perimeter\nT3 topic · queue + DLQ\nstate table POOL | SILO"];
  p4 [label="4 Compute tiers\nT1 · T2 · T4"]; p5 [label="5 IAM per tier\nT1 publish-only"]; p6 [label="6 Saga skeleton\nASL default · override\nper cloud"]; p7 [label="7 Apply graph\nTerraform / Pulumi / CDK", fillcolor="#E3F1E3", color="#3B7D3B"];
