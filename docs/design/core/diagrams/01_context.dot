digraph G {
  graph [rankdir=TB, fontname="DejaVu Sans", fontsize=13, labelloc=t, label=<<b>System context — an agentic platform built on the E2A framework</b>>, fontcolor="#1F3864", nodesep=0.35, ranksep=0.55, pad=0.25];
  node [shape=box, style="rounded,filled", fillcolor="#FFFFFF", color="#1F3864", fontname="DejaVu Sans", fontsize=11, fontcolor="#1F3864", margin="0.18,0.08"];
  edge [color="#2E4A6B", fontname="DejaVu Sans", fontsize=10];
  users [label="Tenant users and systems\n(chat, APIs, batch, agents)"];
  idp [label="Identity provider\n(JWT / claims)"];
  subgraph cluster_p { label=<<b>E2A agentic platform (this design)</b>>; style="rounded,filled"; fillcolor="#EAF2FA"; color="#2E75B6"; fontcolor="#1F3864";
    edge_ [label="Edge — T0 gateway · T1 BaseValidationService", fillcolor="#F4F8FC"];
    orch [label="Tier 2 — BaseWorkflow → BaseAgent / LLMOnlyAgent\ngovernance · observability · idempotency", fillcolor="#DCE8F5"];
    inf [label="Tier 2b — BaseLLMAgentService\n(inference gateway)", fillcolor="#DCE8F5"];
    know [label="Knowledge tier — BaseRAGPipeline\nBaseIndexingPipeline", fillcolor="#F4F8FC"];
    integ [label="Integration tier — BaseToolService\nBaseMCPServer", fillcolor="#F4F8FC"];
    data [label="Tier 3 perimeter — state/outbox, idempotency,\ncache, topics, queues, DLQ", fillcolor="#E6F4F5", color="#0F7C8C"];
    edge_ -> orch; orch -> inf; orch -> know; orch -> integ; orch -> data;
  }
  model [label="Foundation model providers\n(any vendor, private endpoint)"];
  sor [label="Systems of record\n(OLTP, ERP)", shape=cylinder, fillcolor="#E6F4F5", color="#0F7C8C"];
  apis [label="Enterprise APIs and\nexternal MCP servers"];
  saga [label="Saga / compensation\nedge (T5)"];
  obs [label="Telemetry backend"];
  ci [label="CI/CD + IaC\n(BasePipeline, BaseInfraProvisioner)"];
  users -> edge_ [label="HTTPS + JWT"]; idp -> edge_ [style=dashed];
  inf -> model [label="only egress to models"];
  integ -> apis; sor -> know [label="CDC", style=dashed]; integ -> sor [style=dashed];
  data -> saga [label="failed_keys"]; orch -> obs [style=dashed, label="record_telemetry"];
  ci -> orch [style=dashed, label="deploy / provision"];
  {rank=same; users; idp; ci}
  model -> saga [style=invis]; apis -> obs [style=invis]; sor -> obs [style=invis];
}
