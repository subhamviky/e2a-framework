digraph G {
  graph [rankdir=TB, fontname="DejaVu Sans", fontsize=13, labelloc=t, label=<<b>System context — the AI-DLC build service</b>>, fontcolor="#1F3864", nodesep=0.4, ranksep=0.55, pad=0.25];
  node [shape=box, style="rounded,filled", fillcolor="#FFFFFF", color="#1F3864", fontname="DejaVu Sans", fontsize=11, fontcolor="#1F3864", margin="0.18,0.08"];
  edge [color="#2E4A6B", fontname="DejaVu Sans", fontsize=10];
  dev [label="Developer\n(UI: context · harness · prompt panels)"];
  idp [label="Identity provider\n(JWT, repo entitlements)"];
  {rank=same; dev; idp}
  subgraph cluster_s { label=<<b>AI-DLC build service (this design)</b>>; style="rounded,filled"; fillcolor="#EAF2FA"; color="#2E75B6"; fontcolor="#1F3864";
    edge_ [label="Edge — T0 gateway · T1 BaseValidationService\n202 Accepted + correlation_id", fillcolor="#F4F8FC"];
    orch [label="T2 AIDLCPipelineOrchestrator\nPhase A G2C+P0 → Phase B A2C → Phase C E2A verify", fillcolor="#DCE8F5"];
    inf [label="T2b inference gateway\n(BaseLLMAgentService)", fillcolor="#DCE8F5"];
    data [label="T3 perimeter — intake topic · pipeline state ·\nartifact store · idempotency/lock", fillcolor="#E6F4F5", color="#0F7C8C"];
    t4 [label="T4 status stream · webhooks · events", fillcolor="#F4F8FC"];
    t5 [label="T5 saga edge", fillcolor="#F4F8FC"];
    edge_ -> data [label="publish"]; data -> orch [label="push"]; orch -> inf; orch -> data; data -> t4; data -> t5;
  }
  model [label="Model provider\n(private endpoint)"]; git [label="Developer's Git remote"]; ext [label="Chat-ops · ticketing ·\nservice catalogue"];
  dev -> edge_ [label="Execute"]; idp -> edge_ [style=dashed];
  inf -> model [label="only model egress"]; t5 -> git [label="merge / tag or revert"]; t4 -> ext; t4 -> dev [label="live build console", style=dashed];
}
