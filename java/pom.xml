<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <!-- e2a-java: the E2A runtime for Java (design note D-01). Released with E2A's tag, at E2A's version. -->
    <groupId>com.subhamviky.e2a</groupId>
    <artifactId>e2a-java</artifactId>
    <version>1.2.2</version>
    <packaging>pom</packaging>
    <name>e2a-java</name>
    <description>E2A runtime contracts for Java: the v1.2 agent lifecycle, declared workflows, governance stages,
        the Deterministic CQRS profile and a JPA idempotency store.</description>
    <url>https://github.com/subhamviky/e2a-framework</url>
    <licenses>
        <license><name>MIT</name></license>
    </licenses>

    <modules>
        <module>e2a-core</module>
        <module>e2a-cqrs</module>
        <module>e2a-spring-jpa</module>
        <module>e2a-test</module>
    </modules>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring-boot.version>3.5.7</spring-boot.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.subhamviky.e2a</groupId>
                <artifactId>e2a-core</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.4</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
